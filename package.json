{
  "name": "dsh-llm-codex-app-server",
  "version": "0.1.0",
  "description": "DeepSeek Harness LLM provider for Codex models using managed ChatGPT OAuth",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "dsh-codex-login": "lib/login.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
